{
  "name": "medusa-payment-revolut",
  "version": "1.0.0",
  "description": "Unofficial Revolut Merchant API payment provider for Medusa v2. Not affiliated with or endorsed by Revolut.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tewatia5355/medusa-payment-revolut.git"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "payment",
    "revolut"
  ],
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "test": "jest --passWithNoTests src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"spike/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"spike/*.mjs\"",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:adversarial": "node test/e2e/adversarial.mjs",
    "test:e2e:live": "node test/e2e/live-sandbox.cjs",
    "test:e2e:storefront": "node test/e2e/storefront.mjs"
  },
  "devDependencies": {
    "@medusajs/framework": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@swc/core": "^1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "@medusajs/core-flows": "2.19.0"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/core-flows": "2.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
