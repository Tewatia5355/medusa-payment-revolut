{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": ".medusa/server",
    "rootDir": "."
  },
  "include": ["src"],
  "exclude": ["node_modules", ".medusa", "**/__tests__"]
}
